<?xml version="1.0" encoding="utf-8"?>
<GridLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:columnCount="2"
android:rowCount="2">

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_columnWeight="1"
    android:layout_rowWeight="1"
    android:layout_gravity="fill"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/box_peach">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_composable"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="@color/text_color"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/displays_text_and_follows_the_recommended_material_design_guidelines"
        android:textSize="17sp"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/text_color"/>
</LinearLayout>


<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_columnWeight="1"
    android:layout_rowWeight="1"
    android:layout_gravity="fill"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/box_light">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/image_composable"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="@color/text_color"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/creates_a_composable_that_lays_out_and_draws_a_given_painter_class_object"
        android:textSize="17sp"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/text_color"/>
</LinearLayout>


<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_columnWeight="1"
    android:layout_rowWeight="1"
    android:layout_gravity="fill"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/box_light">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/row_composable"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="@color/text_color"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/a_layout_composable_that_places_its_children_in_a_horizontal_sequence"
        android:textSize="17sp"

        android:lineSpacingExtra="5dp"
        android:textColor="@color/text_color"/>
</LinearLayout>


<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_columnWeight="1"
    android:layout_rowWeight="1"
    android:layout_gravity="fill"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/box_peach">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/column_composable"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="@color/text_color"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/a_layout_composable_that_places_its_children_in_a_vertical_sequence"
        android:textSize="17sp"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/text_color"/>
</LinearLayout>

</GridLayout>
